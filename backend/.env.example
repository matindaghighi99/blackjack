# Copy to .env and adjust. Never commit the real .env.
PORT=3000

# Placeholder for a future database connection string.
# DATABASE_URL=

# Placeholder for a future auth provider secret.
# JWT_SECRET=

# IAP receipt validation
# When NODE_ENV != production (or this is 'true'), receipts are accepted without real
# Apple/Google verification so the flow is testable in dev. Set to 'false' + implement the
# real verifiers before shipping.
IAP_ALLOW_UNVERIFIED=true
# NODE_ENV=development

# Apple App Store shared secret (for real verifyReceipt calls)
# APPLE_SHARED_SECRET=
# Google Play service-account JSON path / package name (for real Play API calls)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# ANDROID_PACKAGE_NAME=
