# ==============================================================
#  Unity
# ==============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Unity files
/Assets/AssetStoreTools*
/Assets/Plugins/Editor/JetBrains*
.vsconfig

# Autogenerated project files (IDE)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated meta files
*.FBX.meta
*.fbx.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generation of Gradle
/[Bb]uild[Cc]ache/

# ==============================================================
#  Node / Backend
# ==============================================================
backend/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Environment files (keep .env.example, ignore real secrets)
.env
.env.local
.env.*.local

# ==============================================================
#  OS / Editor
# ==============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
